{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm run dev)",
      "Bash(pnpm build)",
      "Bash(pnpm run build)",
      "Bash(pnpm test)",
      "Bash(pnpm run test)",
      "Bash(pnpm test *)",
      "Bash(pnpm format)",
      "Bash(pnpm run format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm run lint)",
      "Bash(pnpm list *)",
      "Bash(pnpm outdated)",
      "Bash(pnpm --version)",
      "Bash(node --version)",
      "Bash(pnpm preview)",
      "Bash(pnpm run preview)",
      "Bash(pnpm check)",
      "Bash(pnpm run check)",
      "Bash(pnpm astro check)",
      "Bash(pnpm astro check *)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",

      "Bash(ls *)",

      "Edit(/src/**)",
      "Edit(/public/**)",
      "Edit(/_planificacion/00_producto/producto.md)",
      "Edit(/_planificacion/00_producto/registro-pendientes.md)",
      "Edit(/_planificacion/00_producto/registro-archivo.md)",
      "Edit(/_planificacion/00_producto/decisiones.md)",
      "Edit(/_planificacion/00_producto/propuestas-documentos-protegidos.md)",
      "Edit(/_planificacion/10_epicas/epica-*/definicion-epica-*.md)",
      "Edit(/_planificacion/10_epicas/epica-*/iteracion-*.md)",
      "Edit(/_planificacion/10_epicas/epica-*/bitacoras/bitacora-*.md)",

      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm approve-builds *)",
      "Bash(npx *)",

      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git fetch *)",

      "Bash(rm *)",
      "Bash(mv *)",

      "Edit(/.gitignore)",
      "Edit(/.gitattributes)",
      "Edit(/.env.example)",
      "Edit(/package.json)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/tsconfig.json)",
      "Edit(/.nvmrc)",
      "Edit(/.prettierrc.json)",
      "Edit(/astro.config.*)"
    ],
    "deny": [
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Bash(yarn *)",
      "Bash(pnpm publish *)",
      "Bash(pnpm dlx wrangler *)",
      "Bash(pnpm dlx vercel *)",
      "Bash(pnpm dlx netlify-cli *)",
      "Bash(npx wrangler *)",
      "Bash(npx vercel *)",
      "Bash(npx netlify-cli *)",

      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git reset *)",
      "Bash(git tag *)",
      "Bash(git clean *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(git apply *)",
      "Bash(git update-index *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git -C *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git pull *)",
      "PowerShell(git rebase *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git revert *)",
      "PowerShell(git reset *)",
      "PowerShell(git tag *)",
      "PowerShell(git clean *)",
      "PowerShell(git apply *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git filter-repo *)",

      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(wrangler *)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(railway *)",
      "Bash(flyctl *)",
      "Bash(heroku *)",
      "Bash(gcloud *)",
      "Bash(aws *)",
      "Bash(az *)",
      "Bash(docker push *)",
      "Bash(kubectl *)",

      "Edit(/AGENTS.md)",
      "Edit(/DESIGN.md)",
      "Edit(/README.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/CLAUDE.local.md)",
      "Edit(/_planificacion/README.md)",
      "Edit(/_planificacion/plantillas/**)",
      "Edit(/.claude/**)",
      "Edit(/.git/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.dev.vars)",

      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.dev.vars)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-secretos.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/restringir-documentos.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
