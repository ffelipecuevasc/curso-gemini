---
// Un bloque de la clase dentro de su unidad (DESIGN.md, sección 5): título como
// h3, minutos y los botones que abren sus modales (RDA-011): «Ver detalle»
// (resumen, cuerpo Markdown del bloque con render() —RDA-009— y «Profundiza») y
// «Ver prompt» o «Prompts (n)» si el bloque tiene prompts. El cuerpo y los
// prompts viven solo dentro de sus modales; la página queda austera hasta la
// 05-05. Si el cuerpo trae el marcador data-prompt (src/lib/marcadores.ts), en
// su lugar va una línea que remite a la sección de prompts del bloque.
import { render } from "astro:content";
import type { Bloque } from "../lib/unidades";
import { partirEnMarcadores } from "../lib/marcadores";
import Modal from "./Modal.astro";
import Prompt from "./Prompt.astro";
import Profundiza from "./Profundiza.astro";

interface Props {
  bloque: Bloque;
  /** Número de la unidad, para el color de la franja de sus modales. */
  unidad: number;
}

const { bloque, unidad } = Astro.props;
const { numero, titulo, minutos, sintesis, prompts, profundiza } = bloque.data;
const base = bloque.id.replace("/", "-");
const idTitulo = `bloque-${base}`;
const idPrompt = (id: string) => `prompt-${base}-${id}`;

const html = bloque.rendered?.html ?? "";
const tramos = partirEnMarcadores(
  html,
  prompts.map((p) => p.id),
  bloque.id,
);
const conMarcador = tramos.length > 1;
const porId = new Map(prompts.map((p) => [p.id, p]));
const { Content } = await render(bloque);
---

<article aria-labelledby={idTitulo} class="border-t border-linea pt-8">
  <h3 id={idTitulo} class="text-2xl font-semibold wrap-break-word">
    {numero !== undefined && <span>Bloque {numero} · </span>}
    {titulo}
  </h3>
  <p class="mt-1 font-codigo text-sm text-texto-2">{minutos} min</p>
  <div class="mt-4 flex flex-wrap items-start gap-3">
    <Modal
      id={`modal-${base}-detalle`}
      titulo={`Detalle · ${titulo}`}
      unidad={unidad}
      etiqueta="Ver detalle"
      contexto={`de «${titulo}»`}
      descripcion={sintesis.resumen}
    >
      <p class="mb-4 font-codigo text-sm text-texto-2">{minutos} min</p>
      <div class="contenido-bloque">
        {conMarcador ? (
          tramos.map((t) => {
            if (t.tipo === "html") return <Fragment set:html={t.html} />;
            const p = porId.get(t.id)!;
            return (
              <p>
                El prompt «{p.titulo}» está en la sección de prompts de este
                bloque.
              </p>
            );
          })
        ) : (
          <Content />
        )}
      </div>
      {profundiza && <Profundiza profundiza={profundiza} />}
    </Modal>
    {prompts.length > 0 && (
      <Modal
        id={`modal-${base}-prompts`}
        titulo={`Prompts · ${titulo}`}
        unidad={unidad}
        etiqueta={
          prompts.length === 1 ? "Ver prompt" : `Prompts (${prompts.length})`
        }
        contexto={`de «${titulo}»`}
      >
        <div class="grid gap-4">
          {prompts.map((p) => (
            <Prompt
              id={idPrompt(p.id)}
              titulo={p.titulo}
              descripcion={p.descripcion}
              texto={p.texto}
            />
          ))}
        </div>
      </Modal>
    )}
  </div>
</article>
