---
// Una tarjeta del mosaico de la ruta (DESIGN.md, secciones 2.2, 4 y 5):
// número, nombre, mini-proyecto en 2 líneas y barra de avance (RDA-008),
// enlazada a la sección de su unidad. Todo el texto viene de la ficha; el
// mini-proyecto completo está en el modal «Sobre la unidad».
import type { CollectionEntry } from "astro:content";
import { bloqueUnidad } from "../lib/colores-unidad";
import BarraAvance from "./BarraAvance.astro";

interface Props {
  unidad: CollectionEntry<"unidades">;
}

const { unidad } = Astro.props;
const { numero, titulo, miniProyecto, avance } = unidad.data;
const base = `ruta-u${numero}`;
---

<li class="flex">
  <a
    href={`#unidad-${numero}`}
    aria-labelledby={`${base}-numero ${base}-titulo`}
    aria-describedby={`${base}-proyecto ${base}-avance`}
    class:list={["tarjeta-ruta group", bloqueUnidad[numero]]}
  >
    <p id={`${base}-numero`} class="font-display font-semibold">
      Unidad {numero}
    </p>
    <h3
      id={`${base}-titulo`}
      class="titulo-ruta wrap-break-word group-hover:underline"
    >
      {titulo}
    </h3>
    <p id={`${base}-proyecto`} class="line-clamp-2 wrap-break-word">
      <span class="font-medium">Mini-proyecto:</span>{" "}
      {miniProyecto.titulo}
    </p>
    <BarraAvance
      id={`${base}-avance`}
      desde={avance.desde}
      hasta={avance.hasta}
      class="mt-auto"
    />
  </a>
</li>
