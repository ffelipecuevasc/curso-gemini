---
// Una tarjeta del mosaico de la ruta (DESIGN.md, secciones 2.2, 4 y 5; P-024):
// número de la unidad en grande («Unidad» solo para lectores de pantalla),
// nombre, mini-proyecto completo y «Clase n de N · min» al pie, enlazada a la
// sección de su unidad. Sin barra de avance (RDA-013). Todo el texto viene de
// la ficha de la unidad.
import type { CollectionEntry } from "astro:content";
import { bloqueUnidad } from "../lib/colores-unidad";

interface Props {
  unidad: CollectionEntry<"unidades">;
  clases: number;
}

const { unidad, clases } = Astro.props;
const { numero, titulo, miniProyecto, clase, duracionMin } = unidad.data;
const base = `ruta-u${numero}`;
---

<li class="flex">
  <a
    href={`#unidad-${numero}`}
    aria-labelledby={`${base}-numero ${base}-titulo`}
    aria-describedby={`${base}-proyecto ${base}-clase`}
    class:list={["tarjeta-ruta group", bloqueUnidad[numero]]}
  >
    <p id={`${base}-numero`} class="numero-ruta">
      <span class="sr-only">Unidad </span>{numero}
    </p>
    <h3
      id={`${base}-titulo`}
      class="titulo-ruta wrap-break-word group-hover:underline"
    >
      {titulo}
    </h3>
    <p id={`${base}-proyecto`} class="wrap-break-word">
      <span class="font-medium">Mini-proyecto:</span>{" "}
      {miniProyecto.titulo}
    </p>
    <p id={`${base}-clase`} class="mt-auto font-codigo text-sm">
      Clase {clase} de {clases} · {duracionMin} min
    </p>
  </a>
</li>
