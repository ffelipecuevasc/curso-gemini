---
// Botón de modo oscuro. Sin JavaScript queda oculto y la página se ve en claro.
---

<button
  type="button"
  data-boton-modo
  aria-label="Cambiar a modo oscuro"
  class="group/modo relative hidden js:inline-flex size-11 shrink-0 items-center justify-center rounded-pildora border-[1.5px] border-transparent bg-superficie-2 text-texto transition-[background-color,border-color,scale] duration-200 hover:border-primario hover:bg-hover-suave active:scale-[0.97] active:bg-presionado motion-reduce:transition-none motion-reduce:active:scale-100"
>
  <svg
    class="size-5 transition-transform duration-200 group-hover/modo:rotate-[20deg] group-active/modo:rotate-0 group-data-girando/modo:rotate-0 motion-reduce:transition-none motion-reduce:group-hover/modo:rotate-0 oscuro:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg
    class="hidden size-5 transition-transform duration-200 group-hover/modo:rotate-[20deg] group-active/modo:rotate-0 group-data-girando/modo:rotate-0 motion-reduce:transition-none motion-reduce:group-hover/modo:rotate-0 oscuro:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <span
    data-etiqueta-modo
    aria-hidden="true"
    class="pointer-events-none invisible absolute top-full right-0 z-20 mt-2 rounded-pildora border border-linea bg-superficie-2 px-3 py-1 text-xs font-medium whitespace-nowrap text-texto opacity-0 transition-opacity duration-150 group-hover/modo:visible group-hover/modo:opacity-100 group-focus-visible/modo:visible group-focus-visible/modo:opacity-100 motion-reduce:transition-none"
  >
    Cambiar a modo oscuro
  </span>
</button>

<script>
  import {
    hayEleccionGuardada,
    modoActual,
    switchTheme,
  } from "../scripts/modo";

  switchTheme(modoActual(), false);

  for (const boton of document.querySelectorAll<HTMLButtonElement>(
    "[data-boton-modo]",
  )) {
    boton.addEventListener("mouseleave", () =>
      boton.removeAttribute("data-girando"),
    );
    boton.addEventListener("click", () => {
      boton.setAttribute("data-girando", "");
      const cambiar = () =>
        switchTheme(modoActual() === "oscuro" ? "claro" : "oscuro");
      // Sin la API View Transitions o con reducir movimiento: cambio al instante.
      if (
        !document.startViewTransition ||
        matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        cambiar();
        return;
      }
      document.startViewTransition(cambiar);
    });
  }

  // Mientras el participante no elija, se sigue el modo del sistema.
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    if (!hayEleccionGuardada())
      switchTheme(e.matches ? "oscuro" : "claro", false);
  });
</script>
