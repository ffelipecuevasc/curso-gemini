---
// «Instructor» como credencial (DESIGN.md, sección 5; RDA-014, P-029): va justo
// después de la portada. A la izquierda, la insignia de Gemini Certified
// Educator sobre su placa y su vigencia; a la derecha, el h2 «Instructor» como
// etiqueta, el nombre, la certificación, un resumen de la trayectoria (líneas 1
// y 3 de `trayectoria`, aprobadas por el desarrollador el 2026-11-20) y las
// acciones: «Empezar por la Unidad 1», «Ver trayectoria completa» (modal con
// la formación, el detalle de la certificación, el resto de la trayectoria y
// la comunidad) y las redes. Al pie, las 3 cifras de `cifras`. Sin
// JavaScript, el modal se lee en su lugar. La certificación es un logro
// personal del instructor, no un respaldo de Google al curso (AGENTS.md,
// regla de contenido 6).
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import { idModalInstructor } from "../lib/modales";
import BotonModal from "./BotonModal.astro";
import Modal from "./Modal.astro";
import Redes from "./Redes.astro";

const entrada = await getEntry("instructor", "felipe-cuevas");
if (!entrada) {
  throw new Error(
    "Falta la entrada «felipe-cuevas» en src/content/instructor.yaml",
  );
}
const { nombre, formacion, certificacion, trayectoria, cifras, comunidad } =
  entrada.data;

// Resumen visible: posiciones 0 y 2 de `trayectoria`. El resto va al modal.
const visibles = new Set([0, 2]);
const resumen = trayectoria.filter((_, i) => visibles.has(i));
const resto = trayectoria.filter((_, i) => !visibles.has(i));
---

<section
  id="instructor"
  aria-labelledby="titulo-instructor"
  class="mx-auto mt-10 max-w-sitio px-6 lg:mt-12"
>
  <div class="credencial">
    <div class="grid gap-6 lg:grid-cols-[10rem_minmax(0,1fr)] lg:gap-10">
      <div class="flex flex-col gap-2">
        {certificacion.insignia && (
          <div class="placa-insignia w-40 lg:w-auto">
            <Image
              src={certificacion.insignia}
              width={160}
              height={121}
              alt="Insignia de Gemini Certified Educator"
              class="h-auto w-full"
            />
          </div>
        )}
        <p class="font-codigo text-sm text-texto-2">
          Vigente hasta{" "}
          <span class="whitespace-nowrap">{certificacion.vigencia}</span>
        </p>
      </div>

      <div class="min-w-0">
        <h2 id="titulo-instructor" class="etiqueta-credencial">
          Instructor
        </h2>
        <h3 class="nombre-instructor mt-2 wrap-break-word">{nombre}</h3>
        <p class="mt-2 font-display font-semibold text-enlace">
          {certificacion.nombre}{" "}
          <span class="font-texto font-normal text-texto-2">
            (<i lang="en">{certificacion.nombreIngles}</i>,{" "}
            {certificacion.emisor})
          </span>
        </p>
        <ul class="mt-4 max-w-prose list-disc space-y-2 pl-6">
          {resumen.map((linea) => (
            <li>{linea}</li>
          ))}
        </ul>
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3">
          <a href="#unidad-1" class="boton-principal">
            Empezar por la Unidad 1
          </a>
          <BotonModal
            id={idModalInstructor}
            etiqueta="Ver trayectoria completa"
          />
          <Redes class="text-sm" />
        </div>
      </div>
    </div>

    <ul aria-label="La trayectoria en cifras" class="cifras-credencial">
      {cifras.map(({ valor, texto }) => (
        <li>
          <span class="valor-cifra">{valor}</span>
          <span class="block text-sm text-texto-2">{texto}</span>
        </li>
      ))}
    </ul>
  </div>

  <Modal id={idModalInstructor} titulo="Trayectoria completa" nivel={3}>
    <div class="grid max-w-prose gap-4">
      <p>{formacion}</p>
      <div class="rounded-bloque rounded-bl-esquina bg-superficie p-4">
        <p>{certificacion.descripcion}</p>
        <p class="mt-2 text-texto-2">
          Emitida el {certificacion.emision} y válida hasta el{" "}
          {certificacion.vigencia}.
        </p>
        <p class="mt-2">
          <a
            href={certificacion.enlace.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center text-enlace underline"
          >
            {certificacion.enlace.titulo}
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        </p>
      </div>
      <ul class="list-disc space-y-2 pl-6">
        {resto.map((linea) => (
          <li>{linea}</li>
        ))}
        <li>{comunidad}</li>
      </ul>
    </div>
  </Modal>
</section>
