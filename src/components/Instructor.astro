---
// «Instructor» compacto (DESIGN.md, sección 5): nombre, la certificación de
// Gemini primero, un resumen de la trayectoria (líneas 1 y 3 de
// `trayectoria` en instructor.yaml, aprobadas por el desarrollador el
// 2026-11-20), redes y el botón «Ver trayectoria completa», que abre un modal
// con la formación, el detalle de la certificación y su insignia, el resto de
// la trayectoria y la comunidad. Sin JavaScript, el modal se lee en su lugar.
// La certificación es un logro personal del instructor, no un respaldo de
// Google al curso (AGENTS.md, regla de contenido 6).
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import { idModalInstructor } from "../lib/modales";
import BotonModal from "./BotonModal.astro";
import Modal from "./Modal.astro";
import Redes from "./Redes.astro";

const entrada = await getEntry("instructor", "felipe-cuevas");
if (!entrada) {
  throw new Error(
    "Falta la entrada «felipe-cuevas» en src/content/instructor.yaml",
  );
}
const { nombre, formacion, certificacion, trayectoria, comunidad } =
  entrada.data;

// Resumen visible: posiciones 0 y 2 (líneas 18 y 20 del YAML). El resto va al modal.
const visibles = new Set([0, 2]);
const resumen = trayectoria.filter((_, i) => visibles.has(i));
const resto = trayectoria.filter((_, i) => !visibles.has(i));
---

<section
  id="instructor"
  aria-labelledby="titulo-instructor"
  class="mx-auto max-w-sitio border-t border-linea px-6 py-10"
>
  <h2 id="titulo-instructor" class="text-3xl font-semibold">
    Instructor
  </h2>
  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <div>
      <h3 class="text-2xl font-semibold wrap-break-word">{nombre}</h3>
      <p class="mt-2 font-display font-semibold">
        {certificacion.nombre}{" "}
        <span class="font-texto text-base font-normal text-texto-2">
          (<i lang="en">{certificacion.nombreIngles}</i>, {certificacion.emisor}
          )
        </span>
      </p>
      <Redes class="mt-4 text-sm" />
    </div>
    <div>
      <ul class="max-w-prose list-disc space-y-2 pl-6">
        {resumen.map((linea) => (
          <li>{linea}</li>
        ))}
      </ul>
      <div class="mt-4 flex flex-wrap gap-2 empty:hidden">
        <BotonModal
          id={idModalInstructor}
          etiqueta="Ver trayectoria completa"
        />
      </div>
    </div>
  </div>

  <Modal id={idModalInstructor} titulo="Trayectoria completa" nivel={3}>
    <div class="grid max-w-prose gap-4">
      <p>{formacion}</p>
      <div class="flex flex-col gap-4 rounded-bloque rounded-bl-esquina bg-superficie p-4 sm:flex-row sm:items-start">
        {certificacion.insignia && (
          <Image
            src={certificacion.insignia}
            width={120}
            height={120}
            alt="Insignia de Gemini Certified Educator"
            class="size-30 shrink-0"
          />
        )}
        <div>
          <p>{certificacion.descripcion}</p>
          <p class="mt-2 text-texto-2">
            Emitida el {certificacion.emision} y válida hasta el{" "}
            {certificacion.vigencia}.
          </p>
          <p class="mt-2">
            Enlace oficial de la certificación:{" "}
            <a
              href={certificacion.enlace.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center text-enlace underline"
            >
              {certificacion.enlace.titulo}
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </p>
        </div>
      </div>
      <ul class="list-disc space-y-2 pl-6">
        {resto.map((linea) => (
          <li>{linea}</li>
        ))}
        <li>{comunidad}</li>
      </ul>
    </div>
  </Modal>
</section>
