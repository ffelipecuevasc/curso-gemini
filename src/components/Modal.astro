---
// Modal (DESIGN.md, sección 5; RDA-011): el botón que lo abre y su <dialog>
// nativo, con franja del color de la unidad, título, «Cerrar» de 44 px y un
// cuerpo con desplazamiento propio. El contenido va una sola vez, en el slot.
// Sin JavaScript (o sin showModal) el botón no se ve y el <dialog> se muestra
// en su lugar como un bloque normal (global.css, «Modales sin JavaScript»).
interface Props {
  /** ID único en la página: modal-<unidad>-<bloque>-<tipo> o modal-u<N>-<tipo>. */
  id: string;
  /** Título del modal (h3 o h4 según `nivel`). */
  titulo: string;
  /** Número de la unidad, para el color de la franja. */
  unidad: number;
  /** Texto del botón que abre el modal. */
  etiqueta: string;
  /** Continuación del nombre accesible del botón, solo para lectores de pantalla. */
  contexto?: string;
  /** Texto corto bajo el título; el modal lo declara con aria-describedby. */
  descripcion?: string;
  /** Nivel del encabezado: 3 en la unidad, 4 dentro de un bloque. */
  nivel?: 3 | 4;
}

const {
  id,
  titulo,
  unidad,
  etiqueta,
  contexto,
  descripcion,
  nivel = 4,
} = Astro.props;
const Titulo = `h${nivel}` as "h3" | "h4";

// Clases completas por unidad para que Tailwind las detecte.
const franjas: Record<number, string> = {
  1: "border-u1",
  2: "border-u2",
  3: "border-u3",
  4: "border-u4",
};
---

<button
  type="button"
  data-abrir-modal={id}
  aria-haspopup="dialog"
  aria-controls={id}
  class="boton-contorno hidden js:inline-flex"
>
  {etiqueta}
  {contexto && <span class="sr-only"> {contexto}</span>}
</button>

<dialog
  id={id}
  data-modal
  closedby="any"
  aria-labelledby={`${id}-titulo`}
  aria-describedby={descripcion ? `${id}-desc` : undefined}
  class="modal"
>
  <div class:list={["modal-cabecera", franjas[unidad]]}>
    <Titulo
      id={`${id}-titulo`}
      class="font-display text-xl font-semibold wrap-break-word"
    >
      {titulo}
    </Titulo>
    <form method="dialog" data-cerrar class="shrink-0">
      <button type="submit" aria-label="Cerrar" class="boton-icono">
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </form>
  </div>
  <div data-modal-cuerpo class="modal-cuerpo">
    {descripcion && (
      <p id={`${id}-desc`} class="mb-4 max-w-prose text-texto-2">
        {descripcion}
      </p>
    )}
    <slot />
  </div>
</dialog>

<script>
  // Cuarto comportamiento con script permitido (AGENTS.md, regla técnica 2).
  import "../scripts/modal";
</script>
