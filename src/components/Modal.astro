---
// Modal (DESIGN.md, sección 5; RDA-011): el <dialog> nativo con franja del
// color de la unidad, título, «Cerrar» de 44 px y un cuerpo con desplazamiento
// propio. El contenido va una sola vez, en el slot. Lo abre un BotonModal con
// el mismo `id`; sin JavaScript (o sin showModal) ese botón no se ve y el
// <dialog> se muestra en su lugar como un bloque normal (global.css,
// «Modales sin JavaScript»).
import { franjaModal } from "../lib/colores-unidad";

interface Props {
  /** ID único en la página (src/lib/modales.ts). */
  id: string;
  /** Título del modal (h3 o h4 según `nivel`). */
  titulo: string;
  /** Número de la unidad, para el color de la franja; sin unidad (instructor), la franja es --color-primario. */
  unidad?: number;
  /** Texto corto bajo el título; el modal lo declara con aria-describedby. */
  descripcion?: string;
  /** Nivel del encabezado: 3 en la unidad, 4 dentro de un bloque. */
  nivel?: 3 | 4;
}

const { id, titulo, unidad, descripcion, nivel = 4 } = Astro.props;
const Titulo = `h${nivel}` as "h3" | "h4";
---

<dialog
  id={id}
  data-modal
  closedby="any"
  aria-labelledby={`${id}-titulo`}
  aria-describedby={descripcion ? `${id}-desc` : undefined}
  class="modal"
>
  <div
    class:list={[
      "modal-cabecera",
      unidad ? franjaModal[unidad] : "border-primario",
    ]}
  >
    <Titulo
      id={`${id}-titulo`}
      class="font-display text-xl font-semibold wrap-break-word"
    >
      {titulo}
    </Titulo>
    <form method="dialog" data-cerrar class="shrink-0">
      <button type="submit" aria-label="Cerrar" class="boton-icono">
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </form>
  </div>
  <div data-modal-cuerpo class="modal-cuerpo">
    {descripcion && (
      <p id={`${id}-desc`} class="mb-4 max-w-prose text-texto-2">
        {descripcion}
      </p>
    )}
    <slot />
  </div>
</dialog>

<script>
  // Cuarto comportamiento con script permitido (AGENTS.md, regla técnica 2).
  import "../scripts/modal";
</script>
