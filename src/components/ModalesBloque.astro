---
// Los modales de un bloque (DESIGN.md, sección 5, «Modal»; RDA-011): «Detalle»
// (resumen, cuerpo Markdown del bloque con render() —RDA-009— y «Profundiza») y
// «Prompts» si el bloque los tiene. Solo dibuja los <dialog>; los botones que
// los abren viven en la tarjeta (que muestra la primera clave; la segunda va
// aquí, tras el resumen, decisión del 2026-11-20) del bloque o en la cabecera de la unidad
// (src/lib/modales.ts da los mismos `id` a ambos lados). El cuerpo y los
// prompts existen una sola vez, aquí dentro. Si el cuerpo trae el marcador
// data-prompt (src/lib/marcadores.ts), en su lugar va una línea que remite a
// la sección de prompts del bloque.
import { render } from "astro:content";
import type { Bloque } from "../lib/unidades";
import { partirEnMarcadores } from "../lib/marcadores";
import { idModalDetalle, idModalPrompts, idPrompt } from "../lib/modales";
import Modal from "./Modal.astro";
import Prompt from "./Prompt.astro";
import Profundiza from "./Profundiza.astro";

interface Props {
  bloque: Bloque;
  /** Número de la unidad, para el color de la franja de sus modales. */
  unidad: number;
}

const { bloque, unidad } = Astro.props;
const { titulo, numero, minutos, sintesis, prompts, profundiza } = bloque.data;
// El esquema garantiza «numero» o «cierre: true» (content.config.ts); el
// bloque 0 es «Antes de empezar» (decisión del desarrollador, 2026-11-22).
const etiqueta =
  numero === undefined
    ? "Cierre"
    : numero === 0
      ? "Antes de empezar"
      : `Bloque ${numero}`;
const meta = `${etiqueta} · ${minutos} min · Unidad ${unidad}`;

const tramos = partirEnMarcadores(
  bloque.rendered?.html ?? "",
  prompts.map((p) => p.id),
  bloque.id,
);
const conMarcador = tramos.length > 1;
const porId = new Map(prompts.map((p) => [p.id, p]));
const { Content } = await render(bloque);
---

<Modal
  id={idModalDetalle(bloque)}
  titulo={titulo}
  meta={meta}
  unidad={unidad}
  descripcion={sintesis.resumen}
>
  {sintesis.claves[1] && (
    <p class="mb-4 max-w-prose">
      <span class="font-medium">Otra idea clave:</span> {sintesis.claves[1]}
    </p>
  )}
  <div class="contenido-bloque">
    {conMarcador ? (
      tramos.map((t) => {
        if (t.tipo === "html") return <Fragment set:html={t.html} />;
        const p = porId.get(t.id)!;
        return (
          <p>
            El prompt «{p.titulo}» está en la sección de prompts de este bloque.
          </p>
        );
      })
    ) : (
      <Content />
    )}
  </div>
  {profundiza && <Profundiza profundiza={profundiza} />}
</Modal>
{prompts.length > 0 && (
  <Modal
    id={idModalPrompts(bloque)}
    titulo={`Prompts · ${titulo}`}
    meta={meta}
    unidad={unidad}
  >
    <div class="grid gap-4">
      {prompts.map((p) => (
        <Prompt
          id={idPrompt(bloque, p.id)}
          titulo={p.titulo}
          descripcion={p.descripcion}
          texto={p.texto}
        />
      ))}
    </div>
  </Modal>
)}
