---
// Portada y ruta en un pantallazo (DESIGN.md, secciones 5 y 6; P-024, P-029):
// a la izquierda, título (h1), lema, la ficha del curso calculada del
// contenido, botón principal «Conoce a tu instructor» (RDA-014), redes y, bajo
// una línea de 1 px, los logos de Google, GTD Telsur y Capacita Tu Futuro (este
// en --color-primario por currentColor); a la derecha, la ruta del curso como
// índice (sección anidada con `id="ruta"` y su h2, con el logo de Gemini). Los
// SVG no se editan.
import { getEntry } from "astro:content";
import Google from "../assets/iconos/google.svg";
import GtdTelsur from "../assets/iconos/gtd-telsur.svg";
import CapacitaTuFuturo from "../assets/iconos/capacita-tu-futuro.svg";
import { obtenerUnidadesConBloques } from "../lib/unidades";
import Redes from "./Redes.astro";
import RutaCurso from "./RutaCurso.astro";

const curso = await getEntry("curso", "curso");
if (!curso)
  throw new Error("Falta la entrada «curso» en src/content/curso.yaml");
const { titulo, lema, clases, duracionTotalMin } = curso.data;

// Ficha del curso: clases y horas de curso.yaml; bloques (con número mayor
// que 0) y prompts contados de las colecciones al compilar.
const horas = duracionTotalMin / 60;
if (!Number.isInteger(horas)) {
  throw new Error(
    `«duracionTotalMin» (${duracionTotalMin}) no da horas enteras: revisa el texto de la ficha del curso`,
  );
}
const bloques = (await obtenerUnidadesConBloques()).flatMap((u) => u.bloques);
const numerados = bloques.filter((b) => (b.data.numero ?? 0) > 0).length;
const prompts = bloques.reduce((total, b) => total + b.data.prompts.length, 0);
const ficha = [
  `${clases} clases`,
  `${horas} horas`,
  `${numerados} bloques`,
  `${prompts} prompts`,
];
---

<section
  id="inicio"
  aria-labelledby="titulo-inicio"
  class="relative isolate overflow-hidden"
>
  <div
    class="absolute -top-24 -right-32 -z-10 size-80 rounded-full bg-superficie sm:size-96 lg:-top-32 lg:-right-24 lg:size-[32rem]"
    aria-hidden="true"
  ></div>
  <div class="mx-auto grid max-w-sitio grid-cols-1 items-center gap-8 px-6 pt-10 pb-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-10 lg:pt-8">
    <div class="flex flex-col items-start gap-5">
      <h1 id="titulo-inicio" class="titulo-portada">{titulo}</h1>
      <p class="lema-portada">{lema}</p>
      <ul aria-label="El curso en cifras" class="ficha-curso">
        {ficha.map((dato) => <li>{dato}</li>)}
      </ul>
      <a
        href="#instructor"
        class="boton-principal"
      >
        Conoce a tu instructor
      </a>
      <Redes class="text-sm" />
      <div class="flex w-full flex-wrap items-center gap-6 border-t border-linea pt-4 text-texto">
        <Google
          role="img"
          aria-label="Google"
          class="aspect-[512/168] h-6 w-auto"
        />
        <GtdTelsur
          role="img"
          aria-label="GTD Telsur"
          class="aspect-[525/380] h-7 w-auto"
        />
        <CapacitaTuFuturo
          role="img"
          aria-label="Capacita Tu Futuro"
          class="aspect-[1184/442] h-6 w-auto text-primario"
        />
      </div>
    </div>
    <RutaCurso />
  </div>
</section>
