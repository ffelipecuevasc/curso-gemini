---
// Portada y ruta en un pantallazo (DESIGN.md, secciones 5 y 6): a la
// izquierda, título (h1), lema, botón principal y redes; a la derecha, el
// logo de Gemini como protagonista y, en primer plano, la ruta del curso
// (sección anidada con `id="ruta"` y su h2). Logos de Google, GTD Telsur y
// Capacita Tu Futuro en una franja discreta al pie. Los SVG se usan tal cual.
import { getEntry } from "astro:content";
import Gemini from "../assets/iconos/gemini.svg";
import Google from "../assets/iconos/google.svg";
import GtdTelsur from "../assets/iconos/gtd-telsur.svg";
import CapacitaTuFuturo from "../assets/iconos/capacita-tu-futuro.svg";
import Redes from "./Redes.astro";
import RutaCurso from "./RutaCurso.astro";

const curso = await getEntry("curso", "curso");
if (!curso)
  throw new Error("Falta la entrada «curso» en src/content/curso.yaml");
const { titulo, lema } = curso.data;
---

<section
  id="inicio"
  aria-labelledby="titulo-inicio"
  class="relative isolate overflow-hidden"
>
  <div
    class="absolute -top-24 -right-32 -z-10 size-80 rounded-full bg-superficie sm:size-96 lg:-top-32 lg:-right-24 lg:size-[32rem]"
    aria-hidden="true"
  ></div>
  <div class="mx-auto grid max-w-sitio grid-cols-1 items-center gap-8 px-6 pt-10 pb-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-10 lg:pt-8">
    <div class="flex flex-col items-start gap-5">
      <h1
        id="titulo-inicio"
        class="text-4xl leading-tight font-bold sm:text-5xl"
      >
        {titulo}
      </h1>
      <p class="text-xl text-texto-2 lg:text-2xl">{lema}</p>
      <a
        href="#unidad-1"
        class="inline-flex min-h-11 items-center rounded-pildora bg-primario px-6 py-3 font-medium text-sobre-primario no-underline transition-[background-color,color,scale] duration-200 hover:bg-primario-hover active:scale-[0.97] active:bg-presionado active:text-texto motion-reduce:transition-none motion-reduce:active:scale-100"
      >
        Empezar por la Unidad 1
      </a>
      <Redes class="text-sm" />
    </div>
    <div class="relative">
      <Gemini
        role="img"
        aria-label="Gemini"
        class="absolute -top-4 right-0 -z-10 aspect-[296/298] h-28 w-auto sm:h-36"
      />
      <div class="pt-20 sm:pt-24">
        <RutaCurso />
      </div>
    </div>
  </div>
  <div class="mx-auto flex max-w-sitio flex-wrap items-center gap-6 px-6 pb-6 text-texto">
    <Google
      role="img"
      aria-label="Google"
      class="aspect-[512/168] h-6 w-auto"
    />
    <GtdTelsur
      role="img"
      aria-label="GTD Telsur"
      class="aspect-[525/380] h-7 w-auto"
    />
    <CapacitaTuFuturo
      role="img"
      aria-label="Capacita Tu Futuro"
      class="aspect-[1184/442] h-6 w-auto"
    />
  </div>
</section>
