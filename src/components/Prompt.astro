---
// Bloque de prompt (DESIGN.md, sección 5): título, descripción (RDA-012), texto
// literal en IBM Plex Mono sobre superficie-2 y botón «Copiar» grande. Vive
// dentro del modal de prompts de su bloque. Sin JavaScript el botón no aparece
// (variante js:) y el texto sigue seleccionable. El script copia el
// textContent del <code>, así que se copia exactamente lo que se ve.
interface Props {
  /** ID único en la página: prompt-<unidad>-<bloque>-<id>. */
  id: string;
  titulo: string;
  descripcion: string;
  texto: string;
}

const { id, titulo, descripcion, texto } = Astro.props;
---

<figure
  id={id}
  aria-labelledby={`${id}-titulo`}
  aria-describedby={`${id}-desc`}
  class="rounded-bloque rounded-bl-esquina bg-superficie-2 p-4 sm:p-6"
>
  <figcaption class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
    <div class="min-w-0">
      <span
        id={`${id}-titulo`}
        class="font-display font-semibold wrap-break-word"
      >
        {titulo}
      </span>
      <p id={`${id}-desc`} class="mt-1 text-texto-2">
        {descripcion}
      </p>
    </div>
    <button
      type="button"
      data-copiar={`${id}-texto`}
      class="boton-contorno group/copiar hidden js:inline-flex min-h-12 shrink-0 gap-2 self-start px-6"
    >
      <svg
        class="size-5 group-data-copiado/copiar:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
        <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
      </svg>
      <svg
        class="check-copiado hidden size-5 group-data-copiado/copiar:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="m5 12.5 4.5 4.5L19 7.5" pathLength="1"></path>
      </svg>
      <span data-etiqueta>Copiar</span>
      <span class="sr-only">el prompt «{titulo}»</span>
    </button>
  </figcaption>
  <pre class="mt-3 font-codigo text-sm whitespace-pre-wrap wrap-break-word"><code id={`${id}-texto`}>{texto}</code></pre>
  <p
    data-aviso
    aria-live="polite"
    class="mt-2 min-h-6 text-sm text-texto-2"
  ></p>
</figure>

<script>
  // Tercer comportamiento con script permitido (AGENTS.md, regla técnica 2).
  for (const boton of document.querySelectorAll<HTMLButtonElement>(
    "[data-copiar]",
  )) {
    const codigo = document.getElementById(boton.dataset.copiar ?? "");
    const figura = boton.closest("figure");
    const aviso = figura?.querySelector<HTMLElement>("[data-aviso]");
    const etiqueta = boton.querySelector<HTMLElement>("[data-etiqueta]");
    if (!codigo || !aviso || !etiqueta) continue;
    // Sin la API del portapapeles (contexto no seguro) el botón no sirve.
    if (!navigator.clipboard) {
      boton.remove();
      continue;
    }
    let reinicio: ReturnType<typeof setTimeout> | undefined;
    boton.addEventListener("click", async () => {
      clearTimeout(reinicio);
      try {
        await navigator.clipboard.writeText(codigo.textContent ?? "");
        etiqueta.textContent = "Copiado";
        aviso.textContent = "Copiado";
        boton.toggleAttribute("data-copiado", true);
        reinicio = setTimeout(() => {
          etiqueta.textContent = "Copiar";
          aviso.textContent = "";
          boton.toggleAttribute("data-copiado", false);
        }, 2000);
      } catch {
        // El error queda a la vista hasta el próximo intento.
        aviso.textContent = "No se pudo copiar; selecciona el texto";
      }
    });
  }
</script>
