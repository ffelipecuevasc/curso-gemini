---
// Enlace a recurso externo (DESIGN.md, sección 5): ícono de línea según el
// tipo, el nombre del recurso y el sitio de destino. Abre en pestaña nueva y
// lo anuncia (AGENTS.md, regla técnica 8). El título se muestra tal como está
// en recursos.yaml, incluido «(no oficial)» cuando corresponde.
import type { CollectionEntry } from "astro:content";

interface Props {
  recurso: CollectionEntry<"recursos">;
}

const { tipo, titulo, sitio, url } = Astro.props.recurso.data;
const nombreTipo = tipo === "video" ? "Video" : "Documento";
---

<li>
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex min-h-11 items-start gap-3 py-2"
  >
    <svg
      class="mt-0.5 size-5 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {tipo === "video" ? (
        <>
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m10 9 5 3-5 3Z" />
        </>
      ) : (
        <>
          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" />
          <path d="M14 3v5h5M9 13h6M9 17h6" />
        </>
      )}
    </svg>
    <span>
      <span class="sr-only">{nombreTipo}: </span>
      <span class="wrap-break-word">{titulo}</span>
      <span class="block text-sm text-texto-2 no-underline">{sitio}</span>
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </span>
  </a>
</li>
