---
// Redes de felipecuevas.dev (DESIGN.md, secciones 5 y 6, con P-005): ícono y
// texto en un solo enlace; Chrome junto al sitio y LinkedIn junto al perfil.
import Chrome from "../assets/iconos/chrome.svg";
import LinkedIn from "../assets/iconos/linkedin.svg";

interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
---

<ul class:list={["flex flex-wrap gap-x-6 gap-y-1", clase]}>
  <li>
    <a
      href="https://felipecuevas.dev/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-2 text-texto-2 no-underline hover:underline"
    >
      <Chrome class="size-5 shrink-0" aria-hidden="true" focusable="false" />
      <span>www.felipecuevas.dev</span>
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>
  </li>
  <li>
    <a
      href="https://www.linkedin.com/in/ffelipecuevasc/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-2 text-texto-2 no-underline hover:underline"
    >
      <LinkedIn class="size-5 shrink-0" aria-hidden="true" focusable="false" />
      <span>www.linkedin.com/in/ffelipecuevasc/</span>
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>
  </li>
</ul>
