---
// Sección de una unidad (DESIGN.md, sección 5, «Sección de unidad»): una sala
// teñida con el color de la unidad (06-07, RDA-014) reúne la cabecera y una
// cuadrícula de 6 tarjetas (una por bloque numerado y la de «Terminado
// cuando…»), que cabe en una pantalla de escritorio. Todo el detalle va en modales (RDA-011): los de cada bloque
// (ModalesBloque.astro) y los de la unidad —«Sobre la unidad», «Recursos»,
// «Descargas» y «Terminado cuando…»—. Los botones que los abren están en la
// cabecera y en las tarjetas; sin JavaScript, los <dialog> se leen debajo de
// la cuadrícula, una sola vez (global.css, «Modales sin JavaScript»).
// Todo el texto del curso sale de la ficha y de los bloques (RDA-003, RDA-009);
// aquí solo hay etiquetas de interfaz.
import { getEntry } from "astro:content";
import type { UnidadConBloques } from "../lib/unidades";
import { idModalUnidad } from "../lib/modales";
import { salaUnidad } from "../lib/colores-unidad";
import CabeceraUnidad from "./CabeceraUnidad.astro";
import Modal from "./Modal.astro";
import ModalesBloque from "./ModalesBloque.astro";
import RecursoExterno from "./RecursoExterno.astro";
import TarjetaBloque from "./TarjetaBloque.astro";
import TarjetaDescarga from "./TarjetaDescarga.astro";
import TarjetaTerminado from "./TarjetaTerminado.astro";

interface Props {
  unidad: UnidadConBloques;
}

const { unidad } = Astro.props;
const {
  numero,
  nivel,
  objetivo,
  miniProyecto,
  entregable,
  terminadoCuando,
  recursos: referencias,
  descargas: referenciasDescargas,
  notaDescargas,
} = unidad.data;

// Tramos de la nota: los impares iban entre comillas invertidas (código).
const tramosNota = notaDescargas?.split("`") ?? [];

// comprobarReferencias() ya garantiza al compilar que cada recurso existe.
const recursos = await Promise.all(
  referencias.map(async (ref) => (await getEntry(ref))!),
);
const descargas = await Promise.all(
  referenciasDescargas.map(async (ref) => (await getEntry(ref))!),
);

// Los recursos del modal van en dos grupos, cada uno con su cantidad.
const gruposRecursos = [
  { tipo: "documentos", titulo: "Documentos", tipoRecurso: "documento" },
  { tipo: "videos", titulo: "Videos", tipoRecurso: "video" },
]
  .map(({ tipo, titulo, tipoRecurso }) => ({
    tipo,
    titulo,
    recursos: recursos.filter((r) => r.data.tipo === tipoRecurso),
  }))
  .filter((grupo) => grupo.recursos.length > 0);

// Los bloques «0» y de cierre no tienen tarjeta (van como píldoras en la cabecera).
const conTarjeta = unidad.bloques.filter((b) => (b.data.numero ?? 0) >= 1);
const id = `unidad-${numero}`;
---

<section id={id} aria-labelledby={`titulo-${id}`} class="seccion-unidad">
  <div class:list={["sala-unidad", salaUnidad[numero]]}>
    <CabeceraUnidad
      unidad={unidad}
      recursos={recursos.length}
      descargas={descargas.length}
    />

    <div class="cuadricula-bloques">
      {conTarjeta.map((bloque) => (
        <TarjetaBloque bloque={bloque} unidad={numero} />
      ))}
      <TarjetaTerminado
        numero={numero}
        entregable={entregable}
        cantidad={terminadoCuando.length}
      />
    </div>
  </div>

  <div>
    <Modal
      id={idModalUnidad(numero, "sobre")}
      titulo="Sobre la unidad"
      unidad={numero}
      nivel={3}
    >
      <div class="grid max-w-prose gap-4">
        <div>
          <h4 class="font-display text-lg font-semibold">Objetivo</h4>
          <p class="mt-1">{objetivo}</p>
        </div>
        <div>
          <h4 class="font-display text-lg font-semibold">Mini-proyecto</h4>
          <p class="mt-1 font-medium">{miniProyecto.titulo}</p>
          <p class="mt-1">{miniProyecto.descripcion}</p>
        </div>
        <div>
          <h4 class="font-display text-lg font-semibold">Nivel</h4>
          <p class="mt-1">{nivel}</p>
        </div>
      </div>
    </Modal>

    {unidad.bloques.map((bloque) => (
      <ModalesBloque bloque={bloque} unidad={numero} />
    ))}

    <Modal
      id={idModalUnidad(numero, "terminado")}
      titulo="Terminado cuando…"
      unidad={numero}
      nivel={3}
    >
      <ul class="grid max-w-prose gap-1">
        {terminadoCuando.map((linea) => (
          <li>
            <label class="flex min-h-11 items-start gap-3 py-2">
              <input type="checkbox" class="mt-1 size-5 shrink-0" />
              <span>{linea}</span>
            </label>
          </li>
        ))}
      </ul>
    </Modal>

    {recursos.length > 0 && (
      <Modal
        id={idModalUnidad(numero, "recursos")}
        titulo="Recursos de la unidad"
        unidad={numero}
        nivel={3}
      >
        {gruposRecursos.map((grupo) => (
          <section aria-labelledby={`modal-u${numero}-recursos-${grupo.tipo}`}>
            <h4
              id={`modal-u${numero}-recursos-${grupo.tipo}`}
              class="mt-2 font-display text-lg font-semibold"
            >
              {grupo.titulo} ({grupo.recursos.length})
            </h4>
            <ul class="mt-1 grid gap-1">
              {grupo.recursos.map((recurso) => (
                <RecursoExterno recurso={recurso} />
              ))}
            </ul>
          </section>
        ))}
      </Modal>
    )}

    {descargas.length > 0 && (
      <Modal
        id={idModalUnidad(numero, "descargas")}
        titulo="Descargas de la unidad"
        unidad={numero}
        nivel={3}
      >
        {tramosNota.length > 0 && (
          <p class="mb-3 max-w-prose">
            {tramosNota.map((tramo, i) =>
              i % 2 === 1 ? (
                <code class="font-codigo text-sm">{tramo}</code>
              ) : (
                tramo
              ),
            )}
          </p>
        )}
        <ul class="grid gap-3">
          {descargas.map((descarga) => (
            <TarjetaDescarga descarga={descarga} />
          ))}
        </ul>
      </Modal>
    )}
  </div>
</section>
