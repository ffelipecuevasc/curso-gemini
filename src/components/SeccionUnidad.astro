---
// Sección de una unidad (DESIGN.md, sección 5, «Sección de unidad»): encabezado
// con el bloque de color de la unidad, ficha, tabla de bloques con minutos,
// el texto «Para la clase» de cada bloque con sus prompts, los recursos de la
// unidad y, al final, «Entregable» y «Terminado cuando…».
// Todo el texto del curso sale de la ficha y de los bloques (RDA-003, RDA-009);
// aquí solo hay etiquetas de interfaz. Los apartados de la ficha van en h4:
// los h3 son uno por bloque (decisión del desarrollador, 2026-11-17).
import { getEntry } from "astro:content";
import type { UnidadConBloques } from "../lib/unidades";
import BloqueClase from "./BloqueClase.astro";
import Modal from "./Modal.astro";
import RecursoExterno from "./RecursoExterno.astro";
import TarjetaDescarga from "./TarjetaDescarga.astro";

interface Props {
  unidad: UnidadConBloques;
}

const { unidad } = Astro.props;
const {
  numero,
  titulo,
  clase,
  duracionMin,
  nivel,
  avance,
  objetivo,
  miniProyecto,
  entregable,
  holguraMin,
  terminadoCuando,
  recursos: referencias,
  descargas: referenciasDescargas,
  notaDescargas,
} = unidad.data;

// Tramos de la nota: los impares iban entre comillas invertidas (código).
const tramosNota = notaDescargas?.split("`") ?? [];

// comprobarReferencias() ya garantiza al compilar que cada recurso existe.
const recursos = await Promise.all(
  referencias.map(async (ref) => (await getEntry(ref))!),
);
const descargas = await Promise.all(
  referenciasDescargas.map(async (ref) => (await getEntry(ref))!),
);

// Los recursos del modal van en dos grupos, cada uno con su cantidad.
const gruposRecursos = [
  { tipo: "documentos", titulo: "Documentos", tipoRecurso: "documento" },
  { tipo: "videos", titulo: "Videos", tipoRecurso: "video" },
]
  .map(({ tipo, titulo, tipoRecurso }) => ({
    tipo,
    titulo,
    recursos: recursos.filter((r) => r.data.tipo === tipoRecurso),
  }))
  .filter((grupo) => grupo.recursos.length > 0);

// Clases completas por unidad para que Tailwind las detecte (como en
// BloqueUnidad). La U3 lleva el borde de 1 px que pide DESIGN.md en oscuro.
const colores: Record<number, string> = {
  1: "bg-u1 text-sobre-u1",
  2: "bg-u2 text-sobre-u2",
  3: "bg-u3 text-sobre-u3 border border-borde-u3",
  4: "bg-u4 text-sobre-u4",
};

const id = `unidad-${numero}`;
const reparto = (b: UnidadConBloques["bloques"][number]) =>
  b.data.tipo ??
  `Microcharla ${b.data.microcharlaMin} min · práctica ${b.data.practicaMin} min`;
---

<section
  id={id}
  aria-labelledby={`titulo-${id}`}
  class="mx-auto max-w-sitio border-t border-linea px-6 py-16"
>
  <header
    class:list={[
      "rounded-bloque rounded-bl-esquina p-6 sm:p-8",
      colores[numero],
    ]}
  >
    <h2 id={`titulo-${id}`} class="text-3xl font-semibold wrap-break-word">
      Unidad {numero} · {titulo}
    </h2>
    <p class="mt-3">
      Clase {clase} · {duracionMin} min · Nivel: {nivel}
    </p>
    <p class="mt-1 font-codigo">
      <span class="sr-only">Avance del curso:</span>
      {avance.desde}&nbsp;% → {avance.hasta}&nbsp;%
    </p>
  </header>

  <div class="mt-10 grid max-w-prose gap-6">
    <div>
      <h3 class="font-display text-xl font-semibold">Objetivo</h3>
      <p class="mt-2">{objetivo}</p>
    </div>
    <div>
      <h3 class="font-display text-xl font-semibold">Mini-proyecto</h3>
      <p class="mt-2 font-medium">{miniProyecto.titulo}</p>
      <p class="mt-1">{miniProyecto.descripcion}</p>
    </div>
  </div>

  {descargas.length > 0 && (
    <div class="mt-10 flex flex-wrap items-start gap-3">
      <Modal
        id={`modal-u${numero}-descargas`}
        titulo="Descargas de la unidad"
        unidad={numero}
        nivel={3}
        etiqueta={`Descargas (${descargas.length})`}
      >
        {tramosNota.length > 0 && (
          <p class="mb-3 max-w-prose">
            {tramosNota.map((tramo, i) =>
              i % 2 === 1 ? (
                <code class="font-codigo text-sm">{tramo}</code>
              ) : (
                tramo
              ),
            )}
          </p>
        )}
        <ul class="grid gap-3">
          {descargas.map((descarga) => (
            <TarjetaDescarga descarga={descarga} />
          ))}
        </ul>
      </Modal>
    </div>
  )}

  <div class="contenido-bloque mt-10">
    <table>
      <caption>Bloques de la clase</caption>
      <thead>
        <tr>
          <th scope="col">N.º</th>
          <th scope="col">Bloque</th>
          <th scope="col">Tipo</th>
          <th scope="col">Min</th>
        </tr>
      </thead>
      <tbody>
        {unidad.bloques.map((b) => (
          <tr>
            <td>{b.data.numero ?? "—"}</td>
            <th scope="row">{b.data.titulo}</th>
            <td>{reparto(b)}</td>
            <td class="font-codigo">{b.data.minutos}</td>
          </tr>
        ))}
        {holguraMin !== undefined && (
          <tr>
            <td>—</td>
            <th scope="row">Holgura</th>
            <td>—</td>
            <td class="font-codigo">{holguraMin}</td>
          </tr>
        )}
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          <th scope="row">Total</th>
          <td></td>
          <td class="font-codigo">{duracionMin}</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="mt-10 grid gap-10">
    {unidad.bloques.map((bloque) => (
      <BloqueClase bloque={bloque} unidad={numero} />
    ))}
  </div>

  {recursos.length > 0 && (
    <div class="mt-12 flex flex-wrap items-start gap-3 border-t border-linea pt-8">
      <Modal
        id={`modal-u${numero}-recursos`}
        titulo="Recursos de la unidad"
        unidad={numero}
        nivel={3}
        etiqueta={`Recursos (${recursos.length})`}
      >
        {gruposRecursos.map((grupo) => (
          <section aria-labelledby={`modal-u${numero}-recursos-${grupo.tipo}`}>
            <h4
              id={`modal-u${numero}-recursos-${grupo.tipo}`}
              class="mt-2 font-display text-lg font-semibold"
            >
              {grupo.titulo} ({grupo.recursos.length})
            </h4>
            <ul class="mt-1 grid gap-1">
              {grupo.recursos.map((recurso) => (
                <RecursoExterno recurso={recurso} />
              ))}
            </ul>
          </section>
        ))}
      </Modal>
    </div>
  )}

  <div class="mt-12 grid max-w-prose gap-6 border-t border-linea pt-8">
    <div>
      <h3 class="font-display text-xl font-semibold">Entregable</h3>
      <p class="mt-2">{entregable}</p>
    </div>
    <div>
      <h3 class="font-display text-xl font-semibold">Terminado cuando…</h3>
      <ul class="mt-2 list-disc space-y-2 pl-6">
        {terminadoCuando.map((linea) => (
          <li>{linea}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
