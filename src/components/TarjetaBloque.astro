---
// Tarjeta de un bloque numerado (DESIGN.md, sección 5, «Tarjeta de bloque»):
// número y minutos en IBM Plex Mono, título (h3), «Qué harás», la primera clave
// (decisión del desarrollador del 2026-11-20, para que la unidad quepa), la
// marca de la unidad, «Ver detalle» (toda la tarjeta) y el botón de prompts (06-04). El texto sale de `sintesis` (RDA-012);
// el cuerpo completo vive en el modal de detalle (ModalesBloque.astro).
import type { Bloque } from "../lib/unidades";
import { franjaTarjeta } from "../lib/colores-unidad";
import {
  etiquetaPrompts,
  idModalDetalle,
  idModalPrompts,
} from "../lib/modales";
import BotonModal from "./BotonModal.astro";

interface Props {
  bloque: Bloque;
  /** Número de la unidad, para la franja de color. */
  unidad: number;
}

const { bloque, unidad } = Astro.props;
const { numero, titulo, minutos, sintesis, prompts } = bloque.data;
const idTitulo = `tarjeta-${bloque.id.replace("/", "-")}`;
const contexto = `de «${titulo}»`;
---

<article
  aria-labelledby={idTitulo}
  class:list={["tarjeta", franjaTarjeta[unidad]]}
>
  <p class="flex items-center gap-2 font-codigo text-sm text-texto-2">
    <span aria-hidden="true" class="marca-unidad"></span>
    <span class="sr-only">Bloque </span>
    {numero} · {minutos} min
  </p>
  <h3 id={idTitulo} class="text-lg leading-snug font-semibold wrap-break-word">
    {titulo}
  </h3>
  <p>
    <span class="sr-only">Qué harás: </span>
    {sintesis.haras}
  </p>
  <ul class="list-disc pl-5 text-texto-2">
    {sintesis.claves.slice(0, 1).map((clave) => (
      <li>{clave}</li>
    ))}
  </ul>
  <div class="mt-auto flex flex-wrap items-center justify-between gap-2">
    {/* «Ver detalle» (06-04, P-026): enlace de texto cuya capa .cubre-tarjeta
        cubre la tarjeta entera. Ni el botón ni este pie están posicionados,
        para que la capa tome como referencia la .tarjeta. Sin JS, oculto (RDA-011). */}
    <button
      type="button"
      data-abrir-modal={idModalDetalle(bloque)}
      aria-haspopup="dialog"
      aria-controls={idModalDetalle(bloque)}
      class="enlace-tarjeta hidden js:inline-flex"
    >
      Ver detalle
      <span class="sr-only"> {contexto}</span>
      <svg
        aria-hidden="true"
        class="flecha-tarjeta"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 8h10M9 4l4 4-4 4"></path>
      </svg>
      <span aria-hidden="true" class="cubre-tarjeta"></span>
    </button>
    {prompts.length > 0 && (
      <span class="relative z-10 ml-auto">
        <BotonModal
          id={idModalPrompts(bloque)}
          etiqueta={etiquetaPrompts(prompts.length)}
          contexto={contexto}
        />
      </span>
    )}
  </div>
</article>
