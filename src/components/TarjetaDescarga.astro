---
// Tarjeta de descarga (DESIGN.md, sección 5): nombre, formato y peso
// («CSV · 25,4 KB») y botón de contorno «Descargar» (sección 5.1). Formato y
// peso se miden del archivo al compilar (RDA-010; AGENTS.md, regla técnica 7).
import type { CollectionEntry } from "astro:content";
import { datosDescarga } from "../lib/descargas";

interface Props {
  descarga: CollectionEntry<"descargas">;
}

const { titulo, archivo } = Astro.props.descarga.data;
const { formato, peso } = datosDescarga(archivo);
// Se muestra la ruta desde la carpeta del archivo (por ejemplo
// «analista-planillas/SKILL.md») cuando vive en una subcarpeta de
// /descargas/, para distinguir archivos con el mismo nombre. El nombre que
// guarda el navegador no cambia.
const partes = archivo.split("/");
const nombreArchivo =
  partes.length > 3 ? partes.slice(-2).join("/") : partes.at(-1);
---

<li class="flex flex-col gap-3 rounded-bloque rounded-bl-esquina bg-superficie p-4 sm:flex-row sm:items-center sm:justify-between sm:p-6">
  <div class="min-w-0">
    <p class="font-display font-semibold wrap-break-word">{titulo}</p>
    <p class="font-codigo text-sm text-texto-2 wrap-break-word">
      {nombreArchivo} · {formato} · {peso}
    </p>
  </div>
  <a
    href={archivo}
    download
    class="inline-flex min-h-11 shrink-0 items-center self-start rounded-pildora border-[1.5px] border-primario px-4 font-medium text-texto no-underline transition-[background-color,color,scale] duration-200 hover:bg-primario hover:text-sobre-primario active:scale-[0.97] active:bg-presionado active:text-texto motion-reduce:transition-none motion-reduce:active:scale-100 sm:self-auto"
  >
    Descargar
    <span class="sr-only">
      {" "}
      {titulo} ({formato}, {peso})
    </span>
  </a>
</li>
