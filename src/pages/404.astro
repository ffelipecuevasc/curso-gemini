---
// Página de error que Cloudflare sirve en cualquier ruta inexistente
// (`assets.not_found_handling: "404-page"` en wrangler.jsonc).
import Base from "../layouts/Base.astro";

const enlaces = [{ href: "/", texto: "Portada" }];
---

<Base
  titulo="Página no encontrada · Gemini & Google Suite en el Entorno Laboral"
  descripcion="La página que buscas no existe. Vuelve a la portada del curso."
  enlaces={enlaces}
>
  <section aria-labelledby="titulo-404" class="mx-auto max-w-sitio px-6 py-20">
    <div class="flex flex-col items-start gap-6">
      <h1 id="titulo-404" class="text-4xl leading-tight font-bold sm:text-5xl">
        Página no encontrada
      </h1>
      <p class="text-xl text-texto-2">
        La dirección que abriste no existe en este sitio.
      </p>
      <a
        href="/"
        class="inline-flex min-h-11 items-center rounded-pildora bg-primario px-6 py-3 font-medium text-sobre-primario no-underline transition-[background-color,color,scale] duration-200 hover:bg-primario-hover active:scale-[0.97] active:bg-presionado active:text-texto motion-reduce:transition-none motion-reduce:active:scale-100"
      >
        Volver a la portada
      </a>
    </div>
  </section>
</Base>
