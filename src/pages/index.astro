---
// Página única: portada y secciones con su id y su h2. Las secciones
// vacías reciben su contenido en las épicas 02 y 03.
import Base from "../layouts/Base.astro";
import Portada from "../components/Portada.astro";
// RutaCurso llama a obtenerUnidadesConBloques(): las comprobaciones de
// unidades y bloques (RDA-009) corren en cada build a través de ella.
import RutaCurso from "../components/RutaCurso.astro";

const secciones = [
  { id: "ruta", nav: "Ruta", titulo: "Ruta del curso" },
  { id: "unidad-1", nav: "U1", titulo: "Unidad 1 · Fundamentos y prompts" },
  { id: "unidad-2", nav: "U2", titulo: "Unidad 2 · Gemini" },
  { id: "unidad-3", nav: "U3", titulo: "Unidad 3 · Gemini Notebook" },
  { id: "unidad-4", nav: "U4", titulo: "Unidad 4 · Skills e integrador" },
  { id: "instructor", nav: "Instructor", titulo: "Instructor" },
];

const enlaces = secciones.map(({ id, nav }) => ({
  href: `#${id}`,
  texto: nav,
}));
---

<Base
  titulo="Gemini & Google Suite en el Entorno Laboral"
  descripcion="Ruta del curso, prompts listos para copiar, descargas y enlaces a la documentación oficial de Google."
  enlaces={enlaces}
>
  <Portada />
  <RutaCurso />

  {secciones
    .filter(({ id }) => id !== "ruta")
    .map(({ id, titulo }) => (
      <section
        id={id}
        aria-labelledby={`titulo-${id}`}
        class="mx-auto min-h-svh max-w-sitio border-t border-linea px-6 py-16"
      >
        <h2 id={`titulo-${id}`} class="text-3xl font-semibold">
          {titulo}
        </h2>
      </section>
    ))}
</Base>
