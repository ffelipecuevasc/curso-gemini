---
// Página única: portada, ruta, las 4 unidades y el instructor. Los títulos de
// las unidades salen de sus fichas (src/content/unidades/), no de este archivo.
import Base from "../layouts/Base.astro";
import Portada from "../components/Portada.astro";
// RutaCurso también llama a obtenerUnidadesConBloques(): las comprobaciones
// de unidades, bloques y referencias (RDA-009) corren en cada build.
import RutaCurso from "../components/RutaCurso.astro";
import SeccionUnidad from "../components/SeccionUnidad.astro";
import Instructor from "../components/Instructor.astro";
import { obtenerUnidadesConBloques } from "../lib/unidades";

const unidades = await obtenerUnidadesConBloques();

// Etiquetas cortas de la navegación (interfaz, no contenido del curso).
const enlaces = [
  { href: "#ruta", texto: "Ruta" },
  ...unidades.map(({ data }) => ({
    href: `#unidad-${data.numero}`,
    texto: `U${data.numero}`,
  })),
  { href: "#instructor", texto: "Instructor" },
];
---

<Base
  titulo="Gemini & Google Suite en el Entorno Laboral"
  descripcion="Ruta del curso, prompts listos para copiar, descargas y enlaces a la documentación oficial de Google."
  enlaces={enlaces}
>
  <Portada />
  <RutaCurso />
  {unidades.map((unidad) => (
    <SeccionUnidad unidad={unidad} />
  ))}
  <Instructor />
</Base>
